<Window x:Class="ClassroomNoiseMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="550"
        Width="300"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <StackPanel>

            <TextBlock Text="Noise Threshold (0-60)" />
            <TextBlock Text="(Higher = More noise allowed)" FontSize="10" Foreground="Gray"/>
            <TextBox x:Name="ThresholdBox" />

            <TextBlock Text="Reward Points (Silence)" Margin="0,10,0,0"/>
            <TextBox x:Name="RewardBox" />

            <TextBlock Text="Penalty Points (Noise)" Margin="0,10,0,0"/>
            <TextBox x:Name="PenaltyBox" />

            <TextBlock Text="Silence Duration (seconds)" Margin="0,10,0,0"/>
            <TextBlock Text="(How long students must be quiet)" FontSize="10" Foreground="Gray"/>
            <TextBox x:Name="SilenceDurationBox" />

            <TextBlock Text="Celebration Duration (seconds)" Margin="0,10,0,0"/>
            <TextBlock Text="(Quiet time for celebration animation)" FontSize="10" Foreground="Gray"/>
            <TextBox x:Name="CelebrationDurationBox" />

            <TextBlock Text="Visualizer Sensitivity" Margin="0,10,0,0"/>
            <TextBlock Text="(Higher = Taller Bars, Try 50-200)" FontSize="10" Foreground="Gray"/>
            <TextBox x:Name="SensitivityBox" />

            <CheckBox x:Name="SoundAlertCheckBox" 
                      Content="Play sound alert when noise exceeds threshold"
                      Margin="0,15,0,0"
                      FontSize="12"
                      IsChecked="True"/>

            <Button Content="Save"
                    Margin="0,20,0,0"
                    Click="Save_Click"/>

        </StackPanel>
    </Grid>

</Window>
