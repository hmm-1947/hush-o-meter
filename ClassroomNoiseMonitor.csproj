<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    
    <!-- Application Info -->
    <AssemblyName>Hush-o-Meter</AssemblyName>
    <Product>Hush-o-Meter</Product>
    <Company>JoshuaStar</Company>
    <Description>Interactive classroom noise monitoring tool for teachers</Description>
    <Copyright>Copyright © 2026</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- Include default alert sound -->
  <ItemGroup>
    <None Update="sounds\default_alert.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Include icon as resource (if you add app_icon.ico to project) -->
  <ItemGroup>
    <Resource Include="app_icon.ico" Condition="Exists('app_icon.ico')" />
  </ItemGroup>

</Project>