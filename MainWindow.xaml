<Window x:Class="ClassroomNoiseMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hush-o-Meter"
        WindowState="Maximized"
        Background="Black">

    <Grid>

        <!-- Spectrum Visualizer -->
        <Canvas x:Name="SpectrumCanvas"
                Background="Black"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>

        <!-- Top Info - Kid-Friendly Design - Horizontal Layout -->
        <StackPanel VerticalAlignment="Top" Margin="0,40,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
            
            <!-- Noise Level Display -->
            <Border Background="#FF2196F3" 
                    CornerRadius="20" 
                    Padding="30,15"
                    Margin="0,0,15,0"
                    BorderBrush="#FF64B5F6"
                    BorderThickness="4">
                <Border.Effect>
                    <DropShadowEffect Color="#FF2196F3" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔊 Noise: " 
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="DbText"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Text="0" 
                               MinWidth="100"/>
                </StackPanel>
            </Border>

            <!-- Points Display -->
            <Border x:Name="PointsBorder"
                    Background="#FF4CAF50" 
                    CornerRadius="25" 
                    Padding="30,15"
                    Margin="0,0,15,0"
                    BorderBrush="#FF81C784"
                    BorderThickness="5">
                <Border.Effect>
                    <DropShadowEffect Color="#FF4CAF50" BlurRadius="40" ShadowDepth="0" Opacity="0.9"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🌟 Points: " 
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="PointsText"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Text="0" 
                               MinWidth="100"/>
                </StackPanel>
            </Border>

            <!-- Celebration Countdown Display -->
            <Border Background="#FFFF6F00" 
                    CornerRadius="20" 
                    Padding="30,15"
                    BorderBrush="#FFFFA726"
                    BorderThickness="4">
                <Border.Effect>
                    <DropShadowEffect Color="#FFFF6F00" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🎉 Next: " 
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountdownText"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Text="--" 
                               MinWidth="100"/>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- Settings Button - More Colorful -->
        <Button Content="⚙"
                Width="60"
                Height="60"
                FontSize="36"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="20"
                Background="#FFFF9800"
                Foreground="White"
                BorderBrush="#FFFFC107"
                BorderThickness="3"
                Click="OpenSettings_Click">
            <Button.Effect>
                <DropShadowEffect Color="#FFFF9800" BlurRadius="20" ShadowDepth="0"/>
            </Button.Effect>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFFFC107"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Reset Points Button -->
        <Button Content="🔄"
                Width="60"
                Height="60"
                FontSize="36"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="20,100,20,0"
                Background="#FFF44336"
                Foreground="White"
                BorderBrush="#FFEF5350"
                BorderThickness="3"
                Click="ResetPoints_Click">
            <Button.Effect>
                <DropShadowEffect Color="#FFF44336" BlurRadius="20" ShadowDepth="0"/>
            </Button.Effect>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFEF5350"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
